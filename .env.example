# Copy to .env for Docker Compose. Backend variables use the SUBLYNT_ prefix.
SUBLYNT_ENVIRONMENT=development
SUBLYNT_DATABASE_URL=sqlite:////app/data/sublynt.db
SUBLYNT_DATA_DIR=/app/data/files
SUBLYNT_MAX_UPLOAD_BYTES=5242880
SUBLYNT_RETENTION_HOURS=24
SUBLYNT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Host port for the Docker frontend.
SUBLYNT_PORT=3000
# Host port for direct API and OpenAPI access.
SUBLYNT_API_PORT=8000
